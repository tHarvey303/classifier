# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# --- Flask ---
# Session-signing key. Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
FLASK_SECRET_KEY=change-me

# --- Database ---
# With docker-compose this points at the bundled Postgres container ("db" hostname).
# For a quick local run without Docker you can omit this to fall back to SQLite (sqlite:///local.db).
DATABASE_URL=postgresql://postgres:change-me-too@db:5432/classifier

# Password for the bundled Postgres container (docker-compose only).
# Must match the password inside DATABASE_URL above.
POSTGRES_PASSWORD=change-me-too

# --- Object storage (Cloudflare R2, or any S3-compatible store) ---
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS S3: leave blank (boto3 default) or https://s3.<region>.amazonaws.com
# MinIO/self-hosted: https://minio.example.com
R2_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Public domain the browser loads images from (the bucket's public/CDN hostname).
# R2: a custom domain or the r2.dev public development URL for the bucket.
# S3: <bucket>.s3.<region>.amazonaws.com (bucket must allow public reads), or a CloudFront domain.
R2_PUBLIC_DOMAIN=cdn.example.com

# --- App behaviour ---
# Shared key new users must enter to register. Leave unset to allow open registration.
REGISTRATION_PASSPHRASE=pick-a-registration-key

# Comma-separated usernames that are always granted admin rights on login.
ADMIN_USERNAMES=alice,bob

# --- Deployment (docker-compose / Traefik only) ---
# Hostname Traefik routes to this app.
CLASSIFIER_DOMAIN=classifier.example.com
